DATABASE_URL=postgres://obsync:change-me@localhost:5432/obsync
OBSYNC_AUTH_TOKEN=change-me
OBSYNC_HOST=0.0.0.0
OBSYNC_PORT=4444
OBSYNC_DATA_DIR=/data
OBSYNC_ENABLE_WEB_ROUTES=true
OBSYNC_MAX_JSON_BODY_BYTES=1048576
OBSYNC_MAX_DIRECT_UPLOAD_BYTES=33554432
OBSYNC_MAX_WS_MESSAGE_BYTES=1048576

# Optional S3-compatible blob storage.
# If these are omitted, filesystem blob storage under /data/blobs is used.
# OBSYNC_S3_ENDPOINT=http://minio:9000
# OBSYNC_S3_REGION=us-east-1
# OBSYNC_S3_BUCKET=obsync
# OBSYNC_S3_ACCESS_KEY_ID=change-me
# OBSYNC_S3_SECRET_ACCESS_KEY=change-me
# OBSYNC_S3_FORCE_PATH_STYLE=true
