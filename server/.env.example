DATABASE_URL=
OBSYNC_POSTGRES_HOST=localhost
OBSYNC_POSTGRES_PORT=5432
OBSYNC_POSTGRES_DB=obsync
OBSYNC_POSTGRES_USER=obsync
OBSYNC_POSTGRES_PASSWORD=
OBSYNC_AUTH_TOKEN=
OBSYNC_HOST=0.0.0.0
OBSYNC_PORT=4444
OBSYNC_DATA_DIR=/data
OBSYNC_ALLOWED_ORIGINS=
OBSYNC_MAX_JSON_BODY_BYTES=1048576
OBSYNC_MAX_DIRECT_UPLOAD_BYTES=33554432
OBSYNC_MAX_WS_MESSAGE_BYTES=1048576
OBSYNC_MAX_HTTP_CONNECTIONS=1024
OBSYNC_MAX_WS_SESSIONS=256

# Optional S3-compatible blob storage.
# If these are omitted, filesystem blob storage under /data/blobs is used.
