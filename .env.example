OBSYNC_POSTGRES_PASSWORD=change-this-password
OBSYNC_AUTH_TOKEN=change-this-token
OBSYNC_PORT=4444
OBSYNC_STORAGE_QUOTA_BYTES=0

# Опциональное S3-compatible object storage. Оставьте пустым, чтобы использовать локальное filesystem storage.
# OBSYNC_S3_ENDPOINT=https://s3.example.com
# OBSYNC_S3_REGION=us-east-1
# OBSYNC_S3_BUCKET=obsync
# OBSYNC_S3_ACCESS_KEY_ID=change-this-access-key
# OBSYNC_S3_SECRET_ACCESS_KEY=change-this-secret-key
# OBSYNC_S3_FORCE_PATH_STYLE=true
